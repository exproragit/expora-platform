generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  company   String?
  plan      Plan     @default(FREE)
  planStatus PlanStatus @default(ACTIVE)
  stripeCustomerId String?
  stripeSubscriptionId String?
  planStartDate DateTime?
  planEndDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  clients   Client[]
  tests     Test[]
  invoices  Invoice[]
  
  @@map("users")
}

model Client {
  id          String   @id @default(cuid())
  clientId    String   @unique
  name        String
  website     String
  domain      String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  tests       Test[]
  visitors    Visitor[]
  
  @@map("clients")
}

model Test {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      TestStatus  @default(DRAFT)
  type        TestType    @default(AB)
  clientId    String
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  client      Client      @relation(fields: [clientId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  variations  Variation[]
  goals       Goal[]
  results     Result[]
  
  @@map("tests")
}

model Variation {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json     // Store HTML/CSS changes
  traffic     Float    @default(0.5) // Traffic allocation (0-1)
  testId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  test        Test     @relation(fields: [testId], references: [id])
  visitors    Visitor[]
  
  @@map("variations")
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  type        GoalType
  selector    String?  // CSS selector for click tracking
  url         String?  // URL for page view tracking
  testId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  test        Test     @relation(fields: [testId], references: [id])
  conversions Conversion[]
  
  @@map("goals")
}

model Visitor {
  id          String   @id @default(cuid())
  visitorId   String   @unique
  clientId    String
  variationId String?
  testId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  client      Client     @relation(fields: [clientId], references: [id])
  variation   Variation? @relation(fields: [variationId], references: [id])
  conversions Conversion[]
  
  @@map("visitors")
}

model Conversion {
  id          String   @id @default(cuid())
  visitorId   String
  goalId      String
  testId      String
  createdAt   DateTime @default(now())
  
  visitor     Visitor @relation(fields: [visitorId], references: [id])
  goal        Goal    @relation(fields: [goalId], references: [id])
  
  @@map("conversions")
}

model Result {
  id          String   @id @default(cuid())
  testId      String
  variationId String
  visitors    Int      @default(0)
  conversions Int      @default(0)
  conversionRate Float @default(0)
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  test        Test     @relation(fields: [testId], references: [id])
  
  @@map("results")
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  stripeInvoiceId String?
  amount      Int      // Amount in cents
  currency    String   @default("usd")
  status      InvoiceStatus @default(PENDING)
  plan        Plan
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@map("invoices")
}

enum Plan {
  FREE
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum PlanStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

enum TestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TestType {
  AB
  MULTIVARIATE
  SPLIT_URL
  PERSONALIZATION
}

enum GoalType {
  CLICK
  PAGE_VIEW
  FORM_SUBMIT
  PURCHASE
  CUSTOM
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
