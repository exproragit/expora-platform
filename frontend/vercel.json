{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/dashboard.html",
      "dest": "/dashboard.html"
    },
    {
      "src": "/pricing.html",
      "dest": "/pricing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
